    "平均睡眠" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "AVG SLEEP" } } } },
    "起身休息" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "BREAKS" } } } },
    " 次" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : " times" } } } },
    "比上周少 32 分钟" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "32 min less than last week" } } } },
    "答应我的 %lld 次，差一点点" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You promised me %lld — so close" } } } },
    "这周辛苦啦。我发现你一散步心理能量就会回升，下周想不想把傍晚散步固定下来？就当是，陪我出门。" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tough week — well done. I noticed walks always bring your mind energy back. Want to make the evening walk a habit next week? Think of it as keeping me company." } } } },

    "今天也辛苦了" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Another long day — well done" } } } },
    "%@ · 心理能量 %lld · 生理能量 %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ · mind %lld · body %lld" } } } },
    "今天你做到的三件小事" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "THREE LITTLE THINGS YOU DID TODAY" } } } },
    "鼓起勇气见了小林，还聊开了" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Found the courage to meet Lin — and talked it out" } } } },
    "难过的时候没有硬扛，出门走了一圈" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Didn't tough it out alone — went for a walk instead" } } } },
    "喝够了 8 杯水，第一次" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drank all 8 cups of water — a first" } } } },
    "跟着我呼吸 3 分钟" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Breathe with me for 3 min" } } } },
    "跟着我……吸气，呼气" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "With me now… in, and out" } } } },
    "听点雨声" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Some rain sounds" } } } },
    "雨声淅淅沥沥…" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rain is falling…" } } } },
    "明早 7:30 我轻轻叫你" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "I'll wake you gently at 7:30" } } } },
    "晚安，懒猫" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Good night, dozycat" } } } },

    "该歇一会儿了" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Time for a break" } } } },
    "手头的事我帮你原样留着，\n去伸个懒腰、看看窗外。" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "I'll keep everything exactly as you left it.\nGo stretch, look out the window." } } } },
    "提前回来" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Back early" } } } },
