    "没找到。要不换个说法试试？" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Nothing found. Try different words?" } } } },
    "今天" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Today" } } } },
    "「有点怕见小林」——后来你们和好了" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "“A bit nervous to see Lin” — you two made up after" } } } },
    "妈妈想吃你做的番茄牛腩，你说周末回家做" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mom wants your tomato beef stew; you said you'd cook it this weekend" } } } },
    "暖暖的 · 周六提醒你买牛腩" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Warm · I'll remind you to buy beef on Saturday" } } } },
    "连续加班第三天，说「感觉自己像台机器」。那晚只睡了 5 小时" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Third day of overtime — you said you felt like a machine. Only 5 hours of sleep that night" } } } },
    "很累 · 那几天我盯紧一点" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Exhausted · I kept a closer eye on you those days" } } } },
    "和小林见面聊开了，回来路上有点空落落的，散了一圈步" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Met Lin and talked it out; felt a little empty on the way back, took a walk" } } } },
    "松了口气" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Relieved" } } } },
    "喝够了 %lld 杯水，第一次" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drank all %lld cups of water — a first" } } } },

    "这一周的你" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your week" } } } },
