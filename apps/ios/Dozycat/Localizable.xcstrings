    "今日" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Today" } } } },
    "聊天" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Chat" } } } },
    "小传" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Moments" } } } },
    "回顾" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recap" } } } },

    "早上好呀" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Good morning" } } } },
    "下午好呀" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Good afternoon" } } } },
    "晚上好呀" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Good evening" } } } },
    "还没睡呀" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Still up?" } } } },
    "你已经专注了两个小时，\n眼睛离开屏幕一会儿好不好？" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You've been focused for two hours.\nHow about resting your eyes for a bit?" } } } },
    "好，那我 10 分钟后再来叫你。\n说好了哦。" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Okay, I'll come back in 10 minutes.\nPromise." } } } },
    "回来啦。有需要我随时在。" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Welcome back. I'm here whenever you need me." } } } },
    "休息完啦，生理能量回了一点。\n下一段我 50 分钟后再提醒你。" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Break's over — body energy is back up a bit.\nI'll remind you again in 50 minutes." } } } },
    "喝够 8 杯水啦，今天的第一次！\n晚上我会记进「小事」里。" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "That's all 8 cups today — a first!\nI'll note it in tonight's little things." } } } },
    "休息 5 分钟" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest 5 minutes" } } } },
    "再等我一下" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "In a minute" } } } },
    "心理能量" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "MIND ENERGY" } } } },
    "生理能量" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "BODY ENERGY" } } } },
    "喝水 %lld/%lld 杯" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Water %lld/%lld cups" } } } },
    "傍晚散步 · 今天有晚霞" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Evening walk · sunset tonight" } } } },
    "睡前模式 · 今晚早点哦" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Wind-down · early tonight, okay?" } } } },
    "1 小时前" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "1h ago" } } } },
    "刚刚" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "just now" } } } },

    "懒猫" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "dozycat" } } } },
    "一直都在" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "always here" } } } },
    "随便说点什么" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Say anything" } } } },
    "今天 %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Today %@" } } } },
    "今天和小林见面了吧？上周三你还有点紧张来着，见完感觉怎么样？" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You met Lin today, right? You were a bit nervous last Wednesday — how did it go?" } } } },
    "来自小传 · 7月29日「有点怕见小林」" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "From Moments · Jul 29 “a bit nervous to see Lin”" } } } },
    "其实还挺好的，聊开了。就是回来路上有点空落落的" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "It actually went well — we talked it out. Just felt a little empty on the way home" } } } },
    "聊开了就很棒了呀。空落落也没关系，那说明这件事对你重要。要不要出去走一小圈？你每次散完步心情都会好一点，今天 21 度，刚刚好。" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Talking it out is already great. Feeling empty is okay too — it means it mattered. How about a short walk? Walks always lift you a little, and it's 21° out. Just right." } } } },
    "好，走一圈" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Okay, a short walk" } } } },
    "想再说说" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "I want to talk more" } } } },
    "好耶，路上慢一点。回来记得跟我说说晚霞长什么样～" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Yay. Take it slow — and tell me what the sunset looked like when you're back~" } } } },
    "嗯，我在呢。想到哪儿说到哪儿就好。" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mm, I'm here. Start anywhere." } } } },
    "嗯嗯，我听着呢。不用急，慢慢说。" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mm-hm, I'm listening. No rush, take your time." } } } },
    "好。那你现在感觉怎么样？" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Okay. How are you feeling right now?" } } } },
    "记下来啦。想让我以后在合适的时候提醒你吗？" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Noted. Want me to bring it up at the right moment later?" } } } },
    "没关系的，今天已经做得够多了。" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "It's okay. You've done enough for today." } } } },

    "%@ 件小事 · 只存在你自己的设备里" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ little things · stored only on your devices" } } } },
    "搜搜看「上次牙疼是什么时候」" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Try “when was my last toothache”" } } } },
